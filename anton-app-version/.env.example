BOT_TOKEN=
ACTIVE_MODEL=gpt-4o-mini

# Proxy/LLM API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Live public context
BLUESKY_SEARCH_URL=https://api.bsky.app/xrpc/app.bsky.feed.searchPosts
BLUESKY_RESULT_LIMIT=30
BLUESKY_TIMEOUT_SECONDS=15
BLUESKY_LANGUAGE=en

# Runtime
APP_HOST=0.0.0.0
APP_PORT=8000

# Meta Threads API OAuth
META_CLIENT_ID=your_meta_app_id
META_CLIENT_SECRET=your_meta_app_secret
META_REDIRECT_URI=https://your-domain.com/callback

# Bluesky API
BLUESKY_HANDLE=your.handle.bsky.social
BLUESKY_APP_PASSWORD=your-app-password
